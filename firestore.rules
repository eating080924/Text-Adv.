rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth & Identity helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Word Player collection validation
    match /world_players/{playerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() 
        && playerId == request.auth.uid
        && request.resource.data.id == playerId
        && request.resource.data.name is string && request.resource.data.name.size() <= 32
        && request.resource.data.class is string && request.resource.data.class.size() <= 20
        && request.resource.data.faction is string && request.resource.data.faction.size() <= 10
        && request.resource.data.level is int
        && request.resource.data.hp is int
        && request.resource.data.maxHp is int
        && request.resource.data.mp is int
        && request.resource.data.maxMp is int
        && request.resource.data.atk is number
        && request.resource.data.def is number
        && request.resource.data.isInWorld is bool
        && request.resource.data.lastActive is int;
      allow delete: if isSignedIn() && playerId == request.auth.uid;

      // Attacks subcollection
      match /attacks/{attackId} {
        // Only the player themselves can read or clear their incoming attacks
        allow read, delete: if isSignedIn() && playerId == request.auth.uid;
        // Any signed-in rival can write a new attack to target's mailbox
        allow create: if isSignedIn()
          && request.resource.data.attackerUid == request.auth.uid
          && request.resource.data.attackerName is string && request.resource.data.attackerName.size() <= 32
          && request.resource.data.damage is int && request.resource.data.damage >= 0 && request.resource.data.damage <= 10000
          && request.resource.data.timestamp is int;
      }
    }
  }
}
